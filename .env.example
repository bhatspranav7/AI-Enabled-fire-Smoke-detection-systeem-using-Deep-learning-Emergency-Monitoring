# Copy to .env and fill in. .env is git-ignored - never commit secrets.

# Telegram bot (create via @BotFather, get chat id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
