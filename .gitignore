# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Dataset (raw downloads + extracted YOLO split are regenerated by training/prepare_dataset.py)
dataset/raw/
dataset/raw_isfire/
dataset/yolo/
dataset/extracted/

# Model weights / training runs. models/best.pt (~5 MB nano model) IS committed so the
# demo runs on any laptop without retraining; everything else stays out.
models/runs/
*.pt
*.onnx
!models/best.pt

# Runtime output
evidence/*.jpg
evidence/*.png
evidence/*.mp4
logs/*.log
logs/*.jsonl
backend/*.db
backend/*.db-journal

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
